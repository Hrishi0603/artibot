<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="primitive_living_room">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.5 0.5 0.5 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="n_col"><pose>0 5 1 0 0 0</pose><geometry><box><size>10 0.2 2</size></box></geometry></collision>
        <visual name="n_vis"><pose>0 5 1 0 0 0</pose><geometry><box><size>10 0.2 2</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="s_col"><pose>0 -5 1 0 0 0</pose><geometry><box><size>10 0.2 2</size></box></geometry></collision>
        <visual name="s_vis"><pose>0 -5 1 0 0 0</pose><geometry><box><size>10 0.2 2</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="e_col"><pose>5 0 1 0 0 0</pose><geometry><box><size>0.2 10 2</size></box></geometry></collision>
        <visual name="e_vis"><pose>5 0 1 0 0 0</pose><geometry><box><size>0.2 10 2</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
        <collision name="w_col"><pose>-5 0 1 0 0 0</pose><geometry><box><size>0.2 10 2</size></box></geometry></collision>
        <visual name="w_vis"><pose>-5 0 1 0 0 0</pose><geometry><box><size>0.2 10 2</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rug">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4 3 0.01</size></box></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.6 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="sofa">
      <static>true</static>
      <pose>0 -2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="seat_col"><pose>0 0 0.2 0 0 0</pose><geometry><box><size>2.4 0.8 0.4</size></box></geometry></collision>
        <visual name="seat_vis"><pose>0 0 0.2 0 0 0</pose><geometry><box><size>2.4 0.8 0.4</size></box></geometry><material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.2 0.3 0.5 1</diffuse></material></visual>
        
        <collision name="back_col"><pose>0 -0.3 0.6 0 0 0</pose><geometry><box><size>2.4 0.2 0.6</size></box></geometry></collision>
        <visual name="back_vis"><pose>0 -0.3 0.6 0 0 0</pose><geometry><box><size>2.4 0.2 0.6</size></box></geometry><material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.2 0.3 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="coffee_table">
      <static>true</static>
      <pose>0 -1.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 0.6 0.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 0.6 0.4</size></box></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material> 
        </visual>
      </link>
    </model>

    <model name="tv_unit">
      <static>true</static>
      <pose>0 4.5 0 0 0 0</pose>
      <link name="link">
        <collision name="stand_col"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>2 0.6 0.5</size></box></geometry></collision>
        <visual name="stand_vis"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>2 0.6 0.5</size></box></geometry><material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material></visual>
        
        <collision name="tv_col"><pose>0 0 0.9 0 0 0</pose><geometry><box><size>1.4 0.05 0.8</size></box></geometry></collision>
        <visual name="tv_vis"><pose>0 0 0.9 0 0 0</pose><geometry><box><size>1.4 0.05 0.8</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="bookshelf">
      <static>true</static>
      <pose>-4.5 3 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.4 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.4 2.0</size></box></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="floor_lamp">
      <static>true</static>
      <pose>4.5 4.5 0 0 0 0</pose>
      <link name="link">
        <collision name="pole_col"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="pole_vis"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>1.8</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        
        <collision name="head_col"><pose>0 0 1.9 0 0 0</pose><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
        <visual name="head_vis"><pose>0 0 1.9 0 0 0</pose><geometry><sphere><radius>0.2</radius></sphere></geometry><material><ambient>0.9 0.9 0.5 1</ambient><diffuse>0.9 0.9 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <model name="toy_ball">
      <static>false</static> <pose>2 1.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><sphere><radius>0.15</radius></sphere></geometry></collision>
        <visual name="vis">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material> </visual>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz></inertia>
        </inertial>
      </link>
    </model>

    <model name="cardboard_box">
      <static>true</static>
      <pose>-3 -2 0.2 0 0 0.4</pose> <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.7 0.6 0.4 1</ambient><diffuse>0.7 0.6 0.4 1</diffuse></material> </visual>
      </link>
    </model>

    <model name="shoes">
      <static>true</static>
      <pose>1.5 -2.2 0.05 0 0 -0.2</pose>
      <link name="link">
        <collision name="shoe1_col"><pose>0 0.1 0 0 0 0</pose><geometry><box><size>0.3 0.12 0.1</size></box></geometry></collision>
        <visual name="shoe1_vis"><pose>0 0.1 0 0 0 0</pose><geometry><box><size>0.3 0.12 0.1</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <collision name="shoe2_col"><pose>0 -0.1 0 0 0 0</pose><geometry><box><size>0.3 0.12 0.1</size></box></geometry></collision>
        <visual name="shoe2_vis"><pose>0 -0.1 0 0 0 0</pose><geometry><box><size>0.3 0.12 0.1</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>  

  </world>
</sdf>